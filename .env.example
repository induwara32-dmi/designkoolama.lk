# Shared
NODE_ENV=development

# Frontend
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
API_URL=http://localhost:4000/api/v1
CONTENT_FALLBACK_ENABLED=false
# Business WhatsApp number (digits only, country code first, no + or spaces) used by the
# Quote and Contact forms to redirect to a pre-filled wa.me chat after a successful submit.
NEXT_PUBLIC_WHATSAPP_NUMBER=94763536554

# Backend
PORT=4000
FRONTEND_URL=http://localhost:3000
SWAGGER_ENABLED=false
# On Vercel this MUST be a pooled connection string (Neon: the "-pooler" endpoint
# from the Neon dashboard, or append ?pgbouncer=true&connection_limit=1 to a direct
# one) -- every Serverless Function invocation opens its own Prisma connection, and
# a direct connection here will exhaust Postgres's connection limit under load.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler:5432/DATABASE?sslmode=require&pgbouncer=true&connection_limit=1
# Unpooled connection, used only by `prisma migrate` (PgBouncer's transaction pooling
# mode can't run migrations reliably). Neon: the direct (non "-pooler") endpoint.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Phase 6 administrator security (replace through a secret manager). Each secret must be
# unique to this environment and different from the other -- never reuse a value between
# ADMIN_ACCESS_TOKEN_SECRET and ADMIN_REFRESH_TOKEN_SECRET, and rotate both whenever an
# environment's .env may have been exposed (e.g. generate with `openssl rand -hex 64`).
ADMIN_ACCESS_TOKEN_SECRET=replace-with-a-cryptographically-random-secret-of-at-least-32-characters
ADMIN_REFRESH_TOKEN_SECRET=replace-with-a-different-cryptographically-random-secret-of-at-least-32-characters
ADMIN_ACCESS_TOKEN_TTL_SECONDS=900
ADMIN_REFRESH_TOKEN_TTL_DAYS=7
ADMIN_COOKIE_SECURE=false
ADMIN_COOKIE_SAME_SITE=lax
ADMIN_COOKIE_DOMAIN=
ADMIN_FRONTEND_URL=http://localhost:3000

PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_FRONTEND_URL=http://localhost:3000/admin/reset-password
AUTH_DEV_RESET_PROVIDER=true

# Phase 8 signed draft previews (use a distinct random secret)
CONTENT_PREVIEW_SECRET=replace-with-a-cryptographically-random-secret-of-at-least-32-characters
CONTENT_PREVIEW_TTL_SECONDS=900

INITIAL_SUPER_ADMIN_EMAIL=admin@example.com
INITIAL_SUPER_ADMIN_PASSWORD=replace-with-a-strong-password

# Optional direct Admin media uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=designkoolama
MEDIA_MAX_FILE_SIZE_MB=10
