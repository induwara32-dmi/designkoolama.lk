generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection (Neon's PgBouncer endpoint, or add ?pgbouncer=true) -- every
  // Vercel Serverless Function invocation runs in its own process and opens its own
  // Prisma connection, so a direct (unpooled) Postgres connection here would let
  // concurrent invocations exhaust Postgres's connection limit in minutes.
  url       = env("DATABASE_URL")
  // Unpooled connection, used only for `prisma migrate` -- PgBouncer's transaction
  // pooling mode doesn't support the session-level features migrations rely on.
  directUrl = env("DIRECT_URL")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AccountStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum SubmissionStatus {
  NEW
  IN_PROGRESS
  REPLIED
  CLOSED
  SPAM
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

model AdminUser {
  id                 String               @id @default(uuid()) @db.Uuid
  email              String               @unique
  passwordHash       String
  displayName        String
  status             AccountStatus        @default(INVITED)
  failedLoginCount   Int                  @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?
  deletedAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  roles              AdminUserRole[]
  sessions           RefreshSession[]
  activities         ActivityLog[]
  resetTokens        PasswordResetToken[]
  revisionsCreated   ContentRevision[]    @relation("RevisionCreator")
  revisionsPublished ContentRevision[]    @relation("RevisionPublisher")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       AdminUserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model AdminUserRole {
  userId String    @db.Uuid
  roleId String    @db.Uuid
  user   AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  lastUsedAt   DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())
  user         AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Page {
  id                String        @id @default(uuid()) @db.Uuid
  slug              String        @unique
  title             String
  status            ContentStatus @default(DRAFT)
  publishedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  publishedSnapshot Json?
  sections          PageSection[]
  seo               SeoMetadata?

  @@index([status, publishedAt])
}

model PageSection {
  id           String   @id @default(uuid()) @db.Uuid
  pageId       String   @db.Uuid
  key          String
  kind         String
  content      Json
  displayOrder Int      @default(0)
  isEnabled    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  page         Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, key])
  @@index([pageId, displayOrder])
}

model Service {
  id                String             @id @default(uuid()) @db.Uuid
  slug              String             @unique
  name              String
  summary           String
  content           Json
  status            ContentStatus      @default(DRAFT)
  displayOrder      Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  publishedSnapshot Json?
  seo               SeoMetadata?
  projects          PortfolioProject[]
  quoteRequests     QuoteRequest[]

  @@index([status, displayOrder])
}

model PortfolioCategory {
  id                String                          @id @default(uuid()) @db.Uuid
  slug              String                          @unique
  name              String
  cardTitle         String?
  description       String?
  shortDescription  String?
  overview          String?
  iconKey           String?
  cardMediaId       String?                         @db.Uuid
  bannerMediaId     String?                         @db.Uuid
  bannerAltText     String?
  bannerCaption     String?
  status            ContentStatus                   @default(DRAFT)
  publishedSnapshot Json?
  publishedAt       DateTime?
  displayOrder      Int                             @default(0)
  isActive          Boolean                         @default(true)
  projects          PortfolioProject[]
  cardMedia         MediaAsset?                     @relation("PortfolioCategoryCardMedia", fields: [cardMediaId], references: [id], onDelete: SetNull)
  bannerMedia       MediaAsset?                     @relation("PortfolioCategoryBannerMedia", fields: [bannerMediaId], references: [id], onDelete: SetNull)
  galleryImages     PortfolioCategoryGalleryImage[]
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt

  @@index([status, isActive, displayOrder])
}

model PortfolioProject {
  id                String            @id @default(uuid()) @db.Uuid
  slug              String            @unique
  title             String
  clientName        String?
  summary           String
  content           Json
  categoryId        String            @db.Uuid
  serviceId         String?           @db.Uuid
  status            ContentStatus     @default(DRAFT)
  displayOrder      Int               @default(0)
  publishedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?
  publishedSnapshot Json?
  category          PortfolioCategory @relation(fields: [categoryId], references: [id])
  service           Service?          @relation(fields: [serviceId], references: [id])
  media             PortfolioMedia[]
  seo               SeoMetadata?

  @@index([status, categoryId, displayOrder])
}

model PortfolioCategoryGalleryImage {
  id           String            @id @default(uuid()) @db.Uuid
  categoryId   String            @db.Uuid
  mediaId      String            @db.Uuid
  altText      String?
  caption      String?
  displayOrder Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  category     PortfolioCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  media        MediaAsset        @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([categoryId, mediaId])
  @@index([categoryId, displayOrder])
}

model PortfolioMedia {
  id           String           @id @default(uuid()) @db.Uuid
  projectId    String           @db.Uuid
  mediaId      String           @db.Uuid
  displayOrder Int              @default(0)
  project      PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media        MediaAsset       @relation(fields: [mediaId], references: [id])

  @@unique([projectId, mediaId])
  @@index([projectId, displayOrder])
}

model PackageCategory {
  id           String    @id @default(uuid()) @db.Uuid
  slug         String    @unique
  name         String
  headline     String?
  description  String?
  content      Json      @default("{}")
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  packages     Package[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Package {
  id                String           @id @default(uuid()) @db.Uuid
  slug              String           @unique
  categoryId        String           @db.Uuid
  name              String
  subtitle          String?
  description       String?
  price             Decimal?         @db.Decimal(12, 2)
  priceLabel        String?
  currency          String           @default("LKR")
  ctaLabel          String?
  isPopular         Boolean          @default(false)
  isActive          Boolean          @default(true)
  status            ContentStatus    @default(DRAFT)
  displayOrder      Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  publishedSnapshot Json?
  category          PackageCategory  @relation(fields: [categoryId], references: [id])
  features          PackageFeature[]
  quoteRequests     QuoteRequest[]

  @@index([categoryId, status, displayOrder])
}

model PackageFeature {
  id           String  @id @default(uuid()) @db.Uuid
  packageId    String  @db.Uuid
  label        String
  displayOrder Int     @default(0)
  package      Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, displayOrder])
}

model Testimonial {
  id                String        @id @default(uuid()) @db.Uuid
  clientName        String
  clientRole        String?
  company           String?
  quote             String
  rating            Int?
  avatarId          String?       @db.Uuid
  status            ContentStatus @default(DRAFT)
  displayOrder      Int           @default(0)
  avatar            MediaAsset?   @relation(fields: [avatarId], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  publishedSnapshot Json?

  @@index([status, displayOrder])
}

model MediaAsset {
  id                  String                          @id @default(uuid()) @db.Uuid
  providerId          String                          @unique
  kind                MediaKind                       @default(IMAGE)
  url                 String
  secureUrl           String
  title               String
  altText             String
  caption             String?
  folder              String?
  mimeType            String
  bytes               Int
  width               Int?
  height              Int?
  deletedAt           DateTime?
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt
  portfolioUses       PortfolioMedia[]
  testimonialUses     Testimonial[]
  quoteAttachments    QuoteAttachment[]
  categoryCardUses    PortfolioCategory[]             @relation("PortfolioCategoryCardMedia")
  categoryBannerUses  PortfolioCategory[]             @relation("PortfolioCategoryBannerMedia")
  categoryGalleryUses PortfolioCategoryGalleryImage[]

  @@index([folder, createdAt])
}

model QuoteRequest {
  id               String            @id @default(uuid()) @db.Uuid
  fullName         String
  email            String
  phone            String?
  company          String?
  serviceRequired  String
  selectedPackage  String?
  serviceId        String?           @db.Uuid
  packageId        String?           @db.Uuid
  budget           String?
  deadline         DateTime?
  preferredContact String?
  projectDetails   String
  status           SubmissionStatus  @default(NEW)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  attachments      QuoteAttachment[]
  service          Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  package          Package?          @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([serviceId])
  @@index([packageId])
}

model QuoteAttachment {
  id      String       @id @default(uuid()) @db.Uuid
  quoteId String       @db.Uuid
  mediaId String       @db.Uuid
  quote   QuoteRequest @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  media   MediaAsset   @relation(fields: [mediaId], references: [id])

  @@unique([quoteId, mediaId])
}

model ContactMessage {
  id        String           @id @default(uuid()) @db.Uuid
  fullName  String
  email     String
  phone     String?
  company   String?
  subject   String
  message   String
  status    SubmissionStatus @default(NEW)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([status, createdAt])
}

model SiteSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeoMetadata {
  id           String            @id @default(uuid()) @db.Uuid
  title        String
  description  String
  canonicalUrl String?
  noIndex      Boolean           @default(false)
  openGraph    Json?
  pageId       String?           @unique @db.Uuid
  serviceId    String?           @unique @db.Uuid
  projectId    String?           @unique @db.Uuid
  page         Page?             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  service      Service?          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  project      PortfolioProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model ActivityLog {
  id         String     @id @default(uuid()) @db.Uuid
  actorId    String?    @db.Uuid
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime   @default(now())
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model ContentRevision {
  id            String     @id @default(uuid()) @db.Uuid
  resource      String
  entityId      String     @db.Uuid
  version       Int
  payload       Json
  createdById   String?    @db.Uuid
  publishedById String?    @db.Uuid
  createdAt     DateTime   @default(now())
  publishedAt   DateTime?
  createdBy     AdminUser? @relation("RevisionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  publishedBy   AdminUser? @relation("RevisionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([resource, entityId, version])
  @@index([resource, entityId, publishedAt])
  @@index([createdById, createdAt])
}
